top = '.'
out = 'build'

def options(ctx):
    ctx.load('pebble_sdk')

def configure(ctx):
    ctx.load('pebble_sdk')

def build(ctx):
    ctx.load('pebble_sdk')

    binaries = []
    cached_env = ctx.env

    for platform in ctx.env.TARGET_PLATFORMS:
        ctx.env = ctx.all_envs[platform]
        ctx.set_group(ctx.env.PLATFORM_NAME)

        app_elf = '{}/pebble-app.elf'.format(ctx.env.BUILD_DIR)

        # Equivalent to pbl_build(..., bin_type='app') but intentionally
        # omits the legacy memory_usage feature.  The matching PebbleOS tree
        # supplies declarations for the internal BLE APIs exported by our
        # generated internal SDK.
        ctx(
            features='c cprogram pebble_cprogram',
            source=ctx.path.ant_glob('src/c/**/*.c'),
            target=app_elf,
            includes=['include'],
            bin_type='app',
            app=app_elf
        )

        binaries.append({
            'platform': platform,
            'app_elf': app_elf
        })

    ctx.env = cached_env

    ctx.set_group('bundle')
    ctx.pbl_bundle(
        binaries=binaries,
        js=ctx.path.ant_glob([
            'src/pkjs/**/*.js',
            'src/pkjs/**/*.json',
            'src/common/**/*.js'
        ]),
        js_entry_file='src/pkjs/index.js'
    )
